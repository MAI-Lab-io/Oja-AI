DJANGO_DEBUG=True
DJANGO_SECRET_KEY=development-only-change-before-deployment-1234567890
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://oja:oja@127.0.0.1:5432/oja_ai
DB_CONN_MAX_AGE=60
FRONTEND_URL=http://localhost:3000
PLATFORM_NAME=Oja AI
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Provider secrets belong only in this Django environment, never VITE_* variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required in production for shared throttles; optional for one local process.
REDIS_URL=
EMAIL_BACKEND=accounts.mail_backends.ReadableConsoleEmailBackend
DEFAULT_FROM_EMAIL=Oja AI <noreply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Absolute private storage directory; blank uses .local/artifacts for development.
ARTIFACT_STORAGE_ROOT=
UPLOAD_MAX_FILE_BYTES=1073741824
UPLOAD_USER_QUOTA_BYTES=10737418240
# Development mode calculates integrity checks but does not claim malware scanning.
# Production requires clamav and a reachable scanner.
UPLOAD_SCAN_MODE=development
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
